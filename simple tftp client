    # ── COLA DE LOG (thread-safe) ─────────────────────────────────────────
    def _log(self, msg, level="INFO"):
        self._log_queue.put((msg, level))

    def _poll_log(self):
        try:
            while True:
                msg, lvl = self._log_queue.get_nowait()
                self.log_panel.append(msg, lvl)
        except queue.Empty:
            pass
        self.after(100, self._poll_log)

    # ── ACCIONES ──────────────────────────────────────────────────────────
    def _test_connection(self):
        ip   = self.e_ip.get()
        port = self.e_port.get()
        if not ip:
            messagebox.showwarning("Aviso", "Ingresa la IP del servidor.")
            return
        self._log(f"Probando conectividad con {ip}:{port} …", "INFO")

        def do_test():
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                s.settimeout(3)
                # Enviamos un RRQ a un archivo ficticio
                pkt = _build_request(OP_RRQ, ".__test__", "octet")
                s.sendto(pkt, (ip, int(port)))
                raw, _ = s.recvfrom(516)
                s.close()
                opcode = struct.unpack("!H", raw[:2])[0]
                if opcode in (OP_DATA, OP_ERROR, OP_OACK):
                    self.after(0, lambda: self._set_status(True, ip, port))
                    self._log(f"Servidor TFTP responde en {ip}:{port} ✓", "OK")
            except (socket.timeout, OSError) as ex:
                self.after(0, lambda: self._set_status(False, ip, port))
                self._log(f"Sin respuesta de {ip}:{port} — {ex}", "WARN")

        threading.Thread(target=do_test, daemon=True).start()

    def _set_status(self, ok, ip, port):
        if ok:
            self.status_dot.config(fg=GREEN)
            self.status_lbl.config(fg=GREEN, text=f"Conectado  {ip}:{port}")
        else:
            self.status_dot.config(fg=YELLOW)
            self.status_lbl.config(fg=YELLOW, text=f"Sin respuesta  {ip}:{port}")

