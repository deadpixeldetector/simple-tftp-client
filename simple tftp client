class LabeledEntry(tk.Frame):
    """Campo de entrada con etiqueta."""
    def __init__(self, parent, label, default="", width=22, show=None, **kw):
        super().__init__(parent, bg=PANEL_BG, **kw)
        tk.Label(self, text=label, font=FONT_LABEL, bg=PANEL_BG,
                 fg=TEXT_DIM).pack(anchor="w")
        self.var = tk.StringVar(value=default)
        opts = dict(textvariable=self.var, font=FONT_MONO,
                    bg=ENTRY_BG, fg=TEXT_MAIN, bd=0,
                    insertbackground=ACCENT, width=width,
                    relief="flat", highlightthickness=1,
                    highlightcolor=ACCENT, highlightbackground=BORDER)
        if show:
            opts["show"] = show
        self.entry = tk.Entry(self, **opts)
        self.entry.pack(fill="x", ipady=5, pady=(2, 0))

    def get(self):
        return self.var.get().strip()

    def set(self, v):
        self.var.set(v)


class TFTPApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("TFTP Client  ·  Linux Mint")
        self.configure(bg=DARK_BG)
        self.resizable(True, True)
        self.minsize(760, 620)

        self._cancel_event  = threading.Event()
        self._transfer_running = False
        self._history = []          # [(ts, op, file, status)]
        self._log_queue = queue.Queue()

        self._build_ui()
        self._poll_log()
        self.after(100, self._center)

    def _center(self):
        w, h = 860, 680
        sw = self.winfo_screenwidth()
        sh = self.winfo_screenheight()
        self.geometry(f"{w}x{h}+{(sw-w)//2}+{(sh-h)//2}")

    # ── CONSTRUCCIÓN DE LA UI ───────────────────────────────────────────
    def _build_ui(self):
        # Título
        title_bar = tk.Frame(self, bg=DARK_BG)
        title_bar.pack(fill="x", pady=(12, 0))
        tk.Label(title_bar, text="⬡ TFTP CLIENT", font=FONT_TITLE,
                 bg=DARK_BG, fg=ACCENT).pack(side="left", padx=16)
        tk.Label(title_bar, text="RFC 1350 · RFC 2347 · RFC 2348 · RFC 2349",
                 font=FONT_SMALL, bg=DARK_BG, fg=TEXT_DIM).pack(side="left", padx=4)

        self.status_dot = tk.Label(title_bar, text="●", font=("Monospace", 12),
                                   bg=DARK_BG, fg=TEXT_DIM)
        self.status_dot.pack(side="right", padx=6)
