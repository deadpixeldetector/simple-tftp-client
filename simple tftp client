class ToolTip:
    """Tooltip flotante para widgets."""
    def __init__(self, widget, text):
        self.widget = widget
        self.text   = text
        self.tip    = None
        widget.bind("<Enter>", self.show)
        widget.bind("<Leave>", self.hide)

    def show(self, _=None):
        x, y, *_ = self.widget.bbox("insert") if hasattr(self.widget, 'bbox') else (0,0,0,0)
        x += self.widget.winfo_rootx() + 20
        y += self.widget.winfo_rooty() + 20
        self.tip = tk.Toplevel(self.widget)
        self.tip.wm_overrideredirect(True)
        self.tip.wm_geometry(f"+{x}+{y}")
        tk.Label(self.tip, text=self.text, bg="#1c2128", fg=ACCENT,
                 font=FONT_SMALL, bd=1, relief="solid",
                 padx=6, pady=3).pack()

    def hide(self, _=None):
        if self.tip:
            self.tip.destroy()
            self.tip = None


class LogPanel(tk.Frame):
    """Panel de log con colores."""
    def __init__(self, parent, **kw):
        super().__init__(parent, bg=PANEL_BG, **kw)
        header = tk.Frame(self, bg=PANEL_BG)
        header.pack(fill="x", padx=8, pady=(8, 2))
        tk.Label(header, text="▸  REGISTRO DE ACTIVIDAD", font=FONT_BOLD,
                 bg=PANEL_BG, fg=ACCENT).pack(side="left")
        tk.Button(header, text="Limpiar", font=FONT_SMALL,
                  bg=BTN_BG, fg=TEXT_DIM, bd=0, padx=8, pady=2,
                  activebackground=BTN_HOVER, activeforeground=TEXT_MAIN,
                  cursor="hand2", command=self.clear).pack(side="right")

        self.txt = scrolledtext.ScrolledText(
            self, bg="#0a0e14", fg=TEXT_MAIN, font=FONT_MONO,
            bd=0, wrap="word", state="disabled", height=10,
            insertbackground=ACCENT
        )
        self.txt.pack(fill="both", expand=True, padx=8, pady=(0, 8))
        self.txt.tag_configure("INFO",  foreground=TEXT_DIM)
        self.txt.tag_configure("OK",    foreground=GREEN)
        self.txt.tag_configure("WARN",  foreground=YELLOW)
        self.txt.tag_configure("ERROR", foreground=RED)
        self.txt.tag_configure("SEND",  foreground=ACCENT)
        self.txt.tag_configure("RECV",  foreground="#a8dadc")
        self.txt.tag_configure("TIME",  foreground="#444c56")

    def append(self, msg, level="INFO"):
        self.txt.configure(state="normal")
        ts = datetime.datetime.now().strftime("%H:%M:%S")
        self.txt.insert("end", f"[{ts}] ", "TIME")
        self.txt.insert("end", msg + "\n", level)
        self.txt.see("end")
        self.txt.configure(state="disabled")

    def clear(self):
        self.txt.configure(state="normal")
        self.txt.delete("1.0", "end")
        self.txt.configure(state="disabled")


class ProgressPanel(tk.Frame):
    """Barra de progreso + estadísticas."""
    def __init__(self, parent, **kw):
        super().__init__(parent, bg=PANEL_BG, **kw)
        self._build_widgets()
        self.reset()

    def _build_widgets(self):
        style = ttk.Style()
        style.theme_use("default")
        style.configure("TFTP.Horizontal.TProgressbar",
                        troughcolor=ENTRY_BG, background=ACCENT,
                        bordercolor=BORDER, lightcolor=ACCENT, darkcolor=ACCENT)

        f = tk.Frame(self, bg=PANEL_BG)
        f.pack(fill="x", padx=8, pady=6)

        self.pbar = ttk.Progressbar(f, style="TFTP.Horizontal.TProgressbar",
                                    orient="horizontal", length=200, mode="determinate")
        self.pbar.pack(fill="x", expand=True, side="left", padx=(0,8))

        self.pct_var = tk.StringVar(value="— %")
        tk.Label(f, textvariable=self.pct_var, font=FONT_MONO,
                 bg=PANEL_BG, fg=ACCENT, width=6).pack(side="left")

        stats = tk.Frame(self, bg=PANEL_BG)
        stats.pack(fill="x", padx=8, pady=(0, 6))

        for col, (label, attr) in enumerate([
            ("Transferido:", "transferred_var"),
            ("Velocidad:",   "speed_var"),
            ("Tiempo:",      "eta_var"),
        ]):
            tk.Label(stats, text=label, font=FONT_SMALL,
                     bg=PANEL_BG, fg=TEXT_DIM).grid(row=0, column=col*2, sticky="w", padx=(0,2))
            var = tk.StringVar(value="—")
            setattr(self, attr, var)
            tk.Label(stats, textvariable=var, font=FONT_SMALL,
                     bg=PANEL_BG, fg=TEXT_MAIN).grid(row=0, column=col*2+1, sticky="w", padx=(0,16))

    def reset(self):
        self.pbar["value"] = 0
        self.pct_var.set("— %")
        self.transferred_var.set("—")
        self.speed_var.set("—")
        self.eta_var.set("—")

    def update(self, done, total, start_time):
        elapsed = max(time.time() - start_time, 0.001)
        speed   = done / elapsed

        if total and total > 0:
            pct = min(done / total * 100, 100)
            self.pbar["value"] = pct
            self.pct_var.set(f"{pct:.1f}%")
            remaining = (total - done) / speed if speed > 0 else 0
            self.eta_var.set(_fmt_time(remaining))
        else:
            self.pbar.config(mode="indeterminate")
            self.pbar.start(10)
            self.pct_var.set("…")
            self.eta_var.set("—")

        self.transferred_var.set(_fmt_size(done))
        self.speed_var.set(_fmt_size(speed) + "/s")


def _fmt_size(b):
    for unit in ("B", "KB", "MB", "GB"):
        if b < 1024:
            return f"{b:.1f} {unit}"
        b /= 1024
    return f"{b:.1f} TB"

def _fmt_time(secs):
    if secs < 60:
        return f"{secs:.0f}s"
    elif secs < 3600:
        return f"{secs/60:.0f}m {secs%60:.0f}s"
    return f"{secs/3600:.0f}h"


