# ─────────────────────────────────────────
#  PROTOCOLO TFTP  (RFC 1350 + extensiones)
# ─────────────────────────────────────────
OP_RRQ   = 1
OP_WRQ   = 2
OP_DATA  = 3
OP_ACK   = 4
OP_ERROR = 5
OP_OACK  = 6

TFTP_ERRORS = {
    0: "Error no definido",
    1: "Archivo no encontrado",
    2: "Violación de acceso",
    3: "Disco lleno o cuota excedida",
    4: "Operación TFTP ilegal",
    5: "TID desconocido",
    6: "El archivo ya existe",
    7: "Usuario desconocido",
    8: "Opción rechazada",
}

def _build_request(opcode, filename, mode, options=None):
    pkt = struct.pack("!H", opcode)
    pkt += filename.encode("ascii", errors="replace") + b"\x00"
    pkt += mode.encode("ascii") + b"\x00"
    if options:
        for k, v in options.items():
            pkt += str(k).encode("ascii") + b"\x00" + str(v).encode("ascii") + b"\x00"
    return pkt

def _build_ack(block):
    return struct.pack("!HH", OP_ACK, block & 0xFFFF)

def _build_data(block, data):
    return struct.pack("!HH", OP_DATA, block & 0xFFFF) + data

def _build_error(code, msg=""):
    return struct.pack("!HH", OP_ERROR, code) + msg.encode("ascii") + b"\x00"

def _parse_oack(payload):
    opts = {}
    parts = payload.rstrip(b"\x00").split(b"\x00")
    it = iter(parts)
    for k in it:
        try:
            v = next(it)
            opts[k.decode().lower()] = v.decode()
        except StopIteration:
            break
    return opts

class TFTPError(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code

class TFTPTransfer:
    """Clase de bajo nivel para transferencias TFTP."""
    def __init__(self, server_ip, server_port, timeout, block_size,
                 retries, mode, progress_cb=None, log_cb=None, cancel_event=None):
        self.server_ip  = server_ip
        self.server_port= int(server_port)
        self.timeout    = float(timeout)
        self.block_size = int(block_size)
        self.retries    = int(retries)
        self.mode       = mode            # 'octet' | 'netascii'
        self.progress_cb= progress_cb
        self.log_cb     = log_cb
        self.cancel_ev  = cancel_event or threading.Event()
        self.bytes_transferred = 0
        self.start_time = None

    def _log(self, msg, level="INFO"):
        if self.log_cb:
            self.log_cb(msg, level)

    def _sock(self):
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(self.timeout)
        return s

    # ── DESCARGA (RRQ) ──────────────────────────────────────────────────
    def download(self, remote_filename, local_path):
        opts = {"blksize": self.block_size}
        pkt = _build_request(OP_RRQ, remote_filename, self.mode, opts)
        sock = self._sock()
        server_tid = None
        actual_blksize = self.block_size
        file_size = None
        self.bytes_transferred = 0
        self.start_time = time.time()

        try:
            self._log(f"Enviando RRQ → {self.server_ip}:{self.server_port}  archivo: '{remote_filename}'")
            sock.sendto(pkt, (self.server_ip, self.server_port))
            block_num = 0

            with open(local_path, "wb") as f:
                while True:
                    if self.cancel_ev.is_set():
                        self._log("Transferencia cancelada por el usuario.", "WARN")
                        break

                    retry = 0
                    data_pkt = None
                    while retry < self.retries:
                        try:
                            raw, addr = sock.recvfrom(actual_blksize + 4 + 4)
                            server_tid = addr
                            break
                        except socket.timeout:
                            retry += 1
                            self._log(f"  Timeout #{retry} esperando bloque {block_num+1}", "WARN")
                            if retry >= self.retries:
                                raise TimeoutError(f"Sin respuesta tras {self.retries} intentos")
                            # reenviar ACK anterior
                            sock.sendto(_build_ack(block_num), server_tid or (self.server_ip, self.server_port))
                    else:
                        raise TimeoutError("Sin respuesta")

                    opcode = struct.unpack("!H", raw[:2])[0]

                    if opcode == OP_OACK:
                        neg = _parse_oack(raw[2:])
                        if "blksize" in neg:
                            actual_blksize = int(neg["blksize"])
                            self._log(f"  OACK: blksize negociado = {actual_blksize}")
                        if "tsize" in neg:
                            file_size = int(neg["tsize"])
                            self._log(f"  OACK: tamaño del archivo = {self._fmt_size(file_size)}")
                        sock.sendto(_build_ack(0), server_tid)
                        continue

                    elif opcode == OP_DATA:
                        blk = struct.unpack("!H", raw[2:4])[0]
                        chunk = raw[4:]

                        # bloque esperado
                        expected = (block_num + 1) & 0xFFFF
                        if blk == expected:
                            f.write(chunk)
                            self.bytes_transferred += len(chunk)
                            block_num = blk
                            sock.sendto(_build_ack(block_num), server_tid)

                            if self.progress_cb:
                                self.progress_cb(self.bytes_transferred, file_size, self.start_time)

                            if len(chunk) < actual_blksize:
                                self._log(f"Descarga completa ✓  {self._fmt_size(self.bytes_transferred)}", "OK")
                                break
                        elif blk == block_num:
                            # duplicado — reenviar ACK
                            sock.sendto(_build_ack(block_num), server_tid)
                        else:
                            raise TFTPError(0, f"Bloque inesperado: {blk} (esperado {expected})")

                    elif opcode == OP_ERROR:
                        code = struct.unpack("!H", raw[2:4])[0]
                        msg  = raw[4:].rstrip(b"\x00").decode(errors="replace")
                        errtxt = TFTP_ERRORS.get(code, "Error desconocido")
                        raise TFTPError(code, f"[{code}] {errtxt}: {msg}")

                    else:
                        raise TFTPError(0, f"Opcode inesperado: {opcode}")
        finally:
            sock.close()

    # ── ENVÍO (WRQ) ─────────────────────────────────────────────────────
    def upload(self, local_path, remote_filename):
        file_size = os.path.getsize(local_path)
        opts = {"blksize": self.block_size, "tsize": file_size}
        pkt  = _build_request(OP_WRQ, remote_filename, self.mode, opts)
        sock = self._sock()
        server_tid = None
        actual_blksize = self.block_size
        self.bytes_transferred = 0
        self.start_time = time.time()

        try:
            self._log(f"Enviando WRQ → {self.server_ip}:{self.server_port}  archivo: '{remote_filename}'  tamaño: {self._fmt_size(file_size)}")
            sock.sendto(pkt, (self.server_ip, self.server_port))

            with open(local_path, "rb") as f:
                block_num = 0
                first_ack = True

                while True:
                    if self.cancel_ev.is_set():
                        self._log("Transferencia cancelada por el usuario.", "WARN")
                        break

                    # Esperar ACK / OACK
                    retry = 0
                    raw = None
                    while retry < self.retries:
                        try:
                            raw, addr = sock.recvfrom(516)
                            server_tid = addr
                            break
                        except socket.timeout:
                            retry += 1
                            self._log(f"  Timeout #{retry} esperando ACK {block_num}", "WARN")
                            if retry >= self.retries:
                                raise TimeoutError(f"Sin ACK tras {self.retries} intentos")
                            # reenviar último paquete
                            if first_ack:
                                sock.sendto(pkt, (self.server_ip, self.server_port))

                    opcode = struct.unpack("!H", raw[:2])[0]

                    if opcode == OP_OACK:
                        neg = _parse_oack(raw[2:])
                        if "blksize" in neg:
                            actual_blksize = int(neg["blksize"])
                            self._log(f"  OACK: blksize negociado = {actual_blksize}")
                        first_ack = False
                        # Enviar bloque 1
                        block_num = 1
                        chunk = f.read(actual_blksize)
                        sock.sendto(_build_data(block_num, chunk), server_tid)
                        self.bytes_transferred += len(chunk)
                        if self.progress_cb:
                            self.progress_cb(self.bytes_transferred, file_size, self.start_time)
                        if len(chunk) < actual_blksize:
                            # esperar ACK final
                            try:
                                raw2, _ = sock.recvfrom(516)
                                op2 = struct.unpack("!H", raw2[:2])[0]
                                if op2 == OP_ERROR:
                                    code = struct.unpack("!H", raw2[2:4])[0]
                                    msg  = raw2[4:].rstrip(b"\x00").decode(errors="replace")
                                    raise TFTPError(code, TFTP_ERRORS.get(code, msg))
                            except socket.timeout:
                                pass
                            self._log(f"Envío completo ✓  {self._fmt_size(self.bytes_transferred)}", "OK")
                            break
                        continue

                    elif opcode == OP_ACK:
                        blk = struct.unpack("!H", raw[2:4])[0]
                        first_ack = False

                        expected = block_num & 0xFFFF
                        if blk != expected and not (block_num == 0 and blk == 0):
                            # ignorar ACK duplicado
                            continue

                        # Leer siguiente bloque
                        block_num = (block_num + 1) & 0xFFFF
                        chunk = f.read(actual_blksize)
                        if chunk is None:
                            chunk = b""
                        sock.sendto(_build_data(block_num, chunk), server_tid)
                        self.bytes_transferred += len(chunk)
                        if self.progress_cb:
                            self.progress_cb(self.bytes_transferred, file_size, self.start_time)
                        if len(chunk) < actual_blksize:
                            # Esperar ACK final
                            try:
                                raw2, _ = sock.recvfrom(516)
                                op2 = struct.unpack("!H", raw2[:2])[0]
                                if op2 == OP_ERROR:
                                    code = struct.unpack("!H", raw2[2:4])[0]
                                    msg  = raw2[4:].rstrip(b"\x00").decode(errors="replace")
                                    raise TFTPError(code, TFTP_ERRORS.get(code, msg))
                            except socket.timeout:
                                pass
                            self._log(f"Envío completo ✓  {self._fmt_size(self.bytes_transferred)}", "OK")
                            break

                    elif opcode == OP_ERROR:
                        code = struct.unpack("!H", raw[2:4])[0]
                        msg  = raw[4:].rstrip(b"\x00").decode(errors="replace")
                        errtxt = TFTP_ERRORS.get(code, "Error desconocido")
                        raise TFTPError(code, f"[{code}] {errtxt}: {msg}")
                    else:
                        raise TFTPError(0, f"Opcode inesperado: {opcode}")
        finally:
            sock.close()

    @staticmethod
    def _fmt_size(b):
        if b is None:
            return "? bytes"
        for unit in ("B", "KB", "MB", "GB"):
            if b < 1024:
                return f"{b:.1f} {unit}"
            b /= 1024
        return f"{b:.1f} TB"


