        ToolTip(self.e_port.entry,"Puerto estándar TFTP: 69")

    # ── OPCIONES ────────────────────────────────────────────────────────
    def _build_options_panel(self, parent):
        fr = tk.LabelFrame(parent, text="  OPCIONES  ", font=FONT_BOLD,
                           bg=PANEL_BG, fg=ACCENT, bd=1,
                           relief="solid", labelanchor="nw")
