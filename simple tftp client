    def _get_transfer_params(self):
        return {
            "server_ip":  self.e_ip.get(),
            "server_port": self.e_port.get(),
            "timeout":    self.e_timeout.get(),
            "block_size": self.blksize_var.get(),
            "retries":    self.e_retries.get(),
            "mode":       self.mode_var.get(),
        }

    def _validate_ip(self):
        if not self.e_ip.get():
            messagebox.showwarning("Aviso", "Ingresa la IP del servidor TFTP.")
            return False
        return True

    def _start_upload(self):
        if not self._validate_ip(): return
        local = self.up_local_var.get()
        remote = self.up_remote_var.get().strip()
        if not local:
            messagebox.showwarning("Aviso", "Selecciona un archivo a enviar.")
            return
        if not os.path.isfile(local):
            messagebox.showerror("Error", f"Archivo no encontrado:\n{local}")
            return
        if not remote:
            remote = os.path.basename(local)
        self._run_transfer("upload", local, remote)

    def _start_download(self):
        if not self._validate_ip(): return
        remote = self.dl_remote_var.get().strip()
        local_dir = self.dl_local_var.get().strip()
        if not remote:
            messagebox.showwarning("Aviso", "Ingresa el nombre del archivo remoto.")
            return
        local = os.path.join(local_dir, os.path.basename(remote))
        if os.path.exists(local) and not self.overwrite_var.get():
            ok = messagebox.askyesno("Archivo existe",
                                     f"El archivo ya existe:\n{local}\n\n¿Sobreescribir?")
            if not ok:
                return
        self._run_transfer("download", local, remote)

    def _run_transfer(self, op, local, remote):
        if self._transfer_running:
            messagebox.showwarning("Ocupado", "Ya hay una transferencia en curso.")
            return
        self._transfer_running = True
        self._cancel_event.clear()
        self.progress.reset()
        self._set_buttons_state("active")

        params = self._get_transfer_params()
        ts = datetime.datetime.now().strftime("%H:%M:%S")
        op_label = "↑ TX" if op == "upload" else "↓ RX"

        def on_progress(done, total, start):
            self.after(0, lambda: self.progress.update(done, total, start))

        def do():
            success = False
            try:
                t = TFTPTransfer(
                    progress_cb = on_progress,
                    log_cb      = self._log,
                    cancel_event= self._cancel_event,
                    **params,
                )
                if op == "upload":
                    t.upload(local, remote)
                else:
                    t.download(remote, local)
                success = True
                self.after(0, lambda: self.progress.update(
                    t.bytes_transferred, t.bytes_transferred, t.start_time))
            except TFTPError as ex:
                self._log(f"ERROR TFTP: {ex}", "ERROR")
                self.after(0, lambda: messagebox.showerror(
                    "Error TFTP", str(ex)))
            except TimeoutError as ex:
                self._log(f"TIMEOUT: {ex}", "ERROR")
                self.after(0, lambda: messagebox.showerror(
                    "Timeout", str(ex)))
            except PermissionError as ex:
                self._log(f"PERMISO DENEGADO: {ex}", "ERROR")
                self.after(0, lambda: messagebox.showerror("Permisos", str(ex)))
            except Exception as ex:
                self._log(f"Error inesperado: {ex}", "ERROR")
                self.after(0, lambda: messagebox.showerror("Error", str(ex)))
            finally:
                self._transfer_running = False
                status = "✓ OK" if success else ("✕ Cancel" if self._cancel_event.is_set() else "✕ Error")
                self._history.append((ts, op_label, os.path.basename(local), status))
                self.after(0, self._refresh_history)
                self.after(0, lambda: self._set_buttons_state("idle"))

        threading.Thread(target=do, daemon=True).start()

    def _cancel_transfer(self):
        self._cancel_event.set()
        self._log("Cancelando transferencia…", "WARN")

    def _set_buttons_state(self, state):
        active = state == "active"
        s_idle   = "disabled" if active else "normal"
        s_active = "normal"   if active else "disabled"
        for btn, s in [
            (self.btn_upload,    s_idle),
            (self.btn_download,  s_idle),
            (self.btn_cancel_up, s_active),
            (self.btn_cancel_dl, s_active),
        ]:
            btn.config(state=s)

    def _refresh_history(self):
        for row in self.hist_tree.get_children():
            self.hist_tree.delete(row)
        for ts, op, fname, status in reversed(self._history[-50:]):
            tag = "ok" if "OK" in status else ("warn" if "Cancel" in status else "err")
            self.hist_tree.insert("", "end", values=(ts, op, fname, status))


