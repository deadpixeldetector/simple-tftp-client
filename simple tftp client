        sep2.pack(fill="x", pady=4)

        # ── Log
        self.log_panel = LogPanel(self)
        self.log_panel.pack(fill="both", expand=False, padx=12, pady=(0, 8))

    # ── PANEL CONEXIÓN ──────────────────────────────────────────────────
    def _build_connection_panel(self, parent):
        fr = tk.LabelFrame(parent, text="  SERVIDOR  ", font=FONT_BOLD,
                           bg=PANEL_BG, fg=ACCENT, bd=1,
                           relief="solid", labelanchor="nw")
